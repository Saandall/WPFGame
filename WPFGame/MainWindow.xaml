<Window x:Class="WPFGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя первая 2D игра"
        WindowState="Maximized"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">
    <!-- Viewport — то, что видно на экране, размер не меняется (960x540).
         GameArea — весь мир комнаты, может быть больше Viewport. CameraTransform
         сдвигает GameArea внутри Viewport — это и есть камера. ClipToBounds обрезает
         всё, что вышло за пределы видимой области. -->
    <Viewbox Stretch="Uniform">
        <Canvas Name="Viewport" Background="Black" Width="960" Height="540" ClipToBounds="True">
            <Canvas Name="GameArea">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="CameraTransform" X="0" Y="0" />
                </Canvas.RenderTransform>

                <TextBlock Name="AmmoText"
                           Text="7 / 24"
                           FontSize="24"
                           Foreground="White"
                           FontWeight="Bold"
                           Canvas.Left="20"
                           Canvas.Top="20"
                           Panel.ZIndex="100" />
            </Canvas>
        </Canvas>
    </Viewbox>
</Window>
