<Window x:Class="WPFGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя первая 2D игра" Height="450" Width="900"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">


    <!-- Canvas - это наша координатная сетка. Верхний левый угол это X=0, Y=0 -->
    <!-- Xaml рисует слоями, поэтому объекты, которые находятся выше в строчках кода рисуются первыми -->
    <!-- Ранее игрок отрисовывался самым первым, поэтому был позади лестницы, платформ и т.д.. Сейчас вроде норм -->
    <Canvas Name="GameArea" Background="Black">

        <!-- Первый этаж (Пол) -->
        <Rectangle Tag="Ground" Width="900" Height="50" Fill="DarkGray" Canvas.Left="0" Canvas.Top="350" />

        <!-- Второй этаж (Балкон) -->
        <Rectangle Tag="Platform" Width="300" Height="20" Fill="Aqua" Canvas.Left="400" Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <Rectangle Tag="Platform" Width="300" Height="20" Fill="Aqua" Canvas.Left="400" Canvas.Top="100" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <!-- Стена -->
        <!--
        <Rectangle Tag="Ground" Width="20" Height="200" Fill="DarkGray" Canvas.Left="500" Canvas.Top="150" />-->

        <!-- Лестница, соединяющая этажи -->
        <Rectangle Tag="Ladder" Width="40" Height="250" Fill="SaddleBrown" Canvas.Left="450" Canvas.Top="100" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Наш Игрок. Задаем ему размер, цвет и стартовые координаты (Left = X, Top = Y) -->

        <!-- Склон ВВЕРХ-ВПРАВО ( / ). Например, ведет на балкон -->
        <Rectangle Tag="SlopeUpRight" Width="178" Height="150" Fill="LightSlateGray" Opacity="0.8" Canvas.Left="100" Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <!-- Склон ВВЕРХ-ВЛЕВО ( \ ) -->
        <Rectangle Tag="SlopeUpLeft" Width="100" Height="150" Fill="LightSlateGray" Opacity="0.8" Canvas.Left="700" Canvas.Top="200" HorizontalAlignment="Left" VerticalAlignment="Center" />

        <!-- Интерфейс пользователя (HUD) -->
        <TextBlock Name="AmmoText" Text="7 / 24" FontSize="24" Foreground="White" FontWeight="Bold" 
           Canvas.Left="20" Canvas.Top="20" Panel.ZIndex="100"/>
    </Canvas>
</Window>