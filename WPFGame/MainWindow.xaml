<Window x:Class="WPFGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя первая 2D игра"
        WindowState="Maximized"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">

    <!-- Viewbox масштабирует содержимое под размер окна, сохраняя пропорции 1920:1080.
         Это не камера (видно всю комнату целиком, уменьшенную) — временное решение,
         пока не сделали настоящую камеру, которая будет показывать только часть комнаты. -->
    <Viewbox Stretch="Uniform">
        <Canvas Name="GameArea" Background="Black" Width="960" Height="540">

            <Rectangle Name="Player" Width="50" Height="50" Fill="LimeGreen" Canvas.Left="100" Canvas.Top="100" Panel.ZIndex="10" />

        </Canvas>
    </Viewbox>
</Window>