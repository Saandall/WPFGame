<Window x:Class="WPFGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моя первая 2D игра"
        WindowState="Maximized"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown" KeyUp="OnKeyUp">
    <!-- Viewport хранит игровой мир и интерфейс.
         CameraTransform сдвигает только GameArea, поэтому HUD остаётся неподвижным. -->
    <Viewbox Stretch="Uniform">
        <Canvas Name="Viewport"
                Background="Black"
                Width="960"
                Height="540"
                ClipToBounds="True">
            <Canvas Name="GameArea">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="CameraTransform"
                                        X="0"
                                        Y="0" />
                </Canvas.RenderTransform>
            </Canvas>

            <TextBlock Name="AmmoText"
                       Text="7 / 24"
                       FontSize="24"
                       Foreground="White"
                       FontWeight="Bold"
                       Canvas.Left="20"
                       Canvas.Top="20"
                       Panel.ZIndex="100" />

            <!-- Временная debug-информация текущей процедурной станции -->
            <TextBlock Name="StationInfoText"
                       FontSize="12"
                       Foreground="LightGray"
                       Opacity="0.72"
                       Canvas.Left="8"
                       Canvas.Bottom="6"
                       Panel.ZIndex="100"
                       Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</Window>
